{
  "expo": {
    "name": "OpenForge Africa",
    "slug": "openforge-africa",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "africa.openforge.app"
    },
    "android": {
      "package": "africa.openforge.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "scheme": "openforge",
    "experiments": {
      "typedRoutes": true
    }
  }
}
