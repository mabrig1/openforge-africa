{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openforge-classroom-authenticated-candidate",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./worker/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOM_TRIAL_LEDGER",
        "class_name": "ClassroomTrialLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "classroom-ledger-v1",
      "new_sqlite_classes": [
        "ClassroomTrialLedger"
      ]
    }
  ]
}
