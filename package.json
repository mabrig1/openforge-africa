{
  "name": "openforge-africa",
  "version": "0.3.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "expo export --platform web --output-dir dist",
    "check:web": "node scripts/check-web-output.mjs",
    "cf:dry-run": "wrangler deploy --dry-run",
    "check:worker-local": "node scripts/smoke-local-worker.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "nativewind": "^4.0.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-paper": "^5.12.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "zustand": "^5.0.0",
    "react-native-reanimated": "~3.16.1",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-font": "~13.0.4",
    "expo-file-system": "~18.0.12",
    "expo-splash-screen": "~0.29.24",
    "query-string": "^7.1.3",
    "@expo/metro-runtime": "~4.0.1",
    "react-dom": "18.3.1",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "typescript": "^5.3.0",
    "tailwindcss": "^3.4.0",
    "metro": "0.81.5",
    "wrangler": "^4.151.0"
  },
  "private": true
}
