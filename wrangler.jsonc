{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openforge-africa",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./worker/index.ts"
}
